# MongoDB Connection (MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/insertix?retryWrites=true&w=majority

# Admin Authentication
ADMIN_EMAIL=admin@insertixmedia.com
ADMIN_PASSWORD=your_secure_admin_password_here
JWT_SECRET=your_random_32_char_secret_key_here

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://insertixmedia.com
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210
NEXT_PUBLIC_CONTACT_EMAIL=contact@insertixmedia.com

# Notification Emails (Optional)
ADMIN_NOTIFICATION_EMAIL=admin@insertixmedia.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ImageKit CDN (Optional, local upload fallback supported)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Cache Revalidation Secret (Optional)
REVALIDATE_SECRET=